{
  "id": "headless",
  "route": "/os/headless",
  "metadata": {
    "title": "Headless OS",
    "description": "The /os dashboard, composed through the UI runtime instead of hardcoded JSX."
  },
  "definition": {
    "id": "headless-dashboard",
    "kind": "page",
    "children": [
      {
        "id": "root-stack",
        "kind": "layout",
        "type": "stack",
        "children": [
          {
            "id": "page-header",
            "kind": "component",
            "type": "os-page-header",
            "data": { "title": { "source": "greeting" }, "subtitle": { "source": "formattedDate" } },
            "children": [
              {
                "id": "header-actions",
                "kind": "layout",
                "type": "inline",
                "children": [
                  {
                    "id": "filter-bar",
                    "kind": "component",
                    "type": "os-filter-bar",
                    "data": { "channels": { "source": "channels" } }
                  }
                ]
              }
            ]
          },
          {
            "id": "kpi-chart-row",
            "kind": "layout",
            "type": "grid",
            "columns": { "base": 1, "xl": 12 },
            "children": [
              {
                "id": "kpi-grid",
                "kind": "layout",
                "type": "grid",
                "columns": { "base": 1, "md": 2 },
                "layout": { "span": { "xl": 5 } },
                "children": [
                  {
                    "id": "kpi-total-sales",
                    "kind": "component",
                    "type": "os-kpi",
                    "props": { "title": "Total Sales", "icon": "DollarSign" },
                    "data": {
                      "value": { "source": "kpis", "path": "total_sales.value" },
                      "delta": { "source": "kpis", "path": "total_sales.delta" }
                    }
                  },
                  {
                    "id": "kpi-total-orders",
                    "kind": "component",
                    "type": "os-kpi",
                    "props": { "title": "Total Orders", "icon": "ShoppingBag" },
                    "data": {
                      "value": { "source": "kpis", "path": "total_orders.value" },
                      "delta": { "source": "kpis", "path": "total_orders.delta" }
                    }
                  },
                  {
                    "id": "kpi-customer-growth",
                    "kind": "component",
                    "type": "os-kpi",
                    "props": { "title": "Customer Growth", "icon": "Users" },
                    "data": {
                      "value": { "source": "kpis", "path": "customer_growth.value" },
                      "delta": { "source": "kpis", "path": "customer_growth.delta" }
                    }
                  },
                  {
                    "id": "kpi-average-order",
                    "kind": "component",
                    "type": "os-kpi",
                    "props": { "title": "Average Order", "icon": "ReceiptText" },
                    "data": {
                      "value": { "source": "kpis", "path": "average_order.value" },
                      "delta": { "source": "kpis", "path": "average_order.delta" }
                    }
                  },
                  {
                    "id": "kpi-return-requests",
                    "kind": "component",
                    "type": "os-kpi",
                    "props": { "title": "Return Requests", "icon": "RotateCcw" },
                    "data": {
                      "value": { "source": "kpis", "path": "return_requests.value" },
                      "delta": { "source": "kpis", "path": "return_requests.delta" }
                    }
                  },
                  {
                    "id": "kpi-stock-accuracy",
                    "kind": "component",
                    "type": "os-kpi",
                    "props": { "title": "Stock Accuracy", "icon": "PackageCheck" },
                    "data": {
                      "value": { "source": "kpis", "path": "stock_accuracy.value" },
                      "delta": { "source": "kpis", "path": "stock_accuracy.delta" }
                    }
                  }
                ]
              },
              {
                "id": "sales-overview-card",
                "kind": "component",
                "type": "os-card",
                "layout": { "span": { "xl": 7 } },
                "props": { "title": "Sales Overview", "className": "rounded-none border-0 ring-0" },
                "children": [
                  {
                    "id": "sales-overview-chart",
                    "kind": "component",
                    "type": "os-chart",
                    "data": {
                      "points": { "source": "salesTrend", "path": "points" },
                      "defaultCurrency": { "source": "defaultCurrency" }
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "products-inventory-row",
            "kind": "layout",
            "type": "grid",
            "columns": { "base": 1, "xl": 12 },
            "children": [
              {
                "id": "top-products",
                "kind": "component",
                "type": "os-top-products",
                "layout": { "span": { "xl": 6 } },
                "data": {
                  "overview": { "source": "topProducts" },
                  "defaultCurrency": { "source": "defaultCurrency" }
                }
              },
              {
                "id": "inventory-gauge",
                "kind": "component",
                "type": "os-inventory-gauge",
                "layout": { "span": { "xl": 6 } },
                "data": { "mix": { "source": "stockMix" } }
              }
            ]
          },
          {
            "id": "recent-orders-table",
            "kind": "component",
            "type": "os-data-table",
            "props": {
              "title": "Recent Orders",
              "searchable": true,
              "searchPlaceholder": "Search orders...",
              "filterable": true,
              "columnVisibility": true,
              "compulsoryColumns": ["id", "customer"],
              "minVisibleColumns": 3,
              "selectable": true,
              "paginated": true,
              "pageSize": 10,
              "emptyMessage": "No orders found."
            },
            "data": { "data": { "source": "recentOrders" } }
          }
        ]
      }
    ]
  }
}
