{
  "id": "headless/customers",
  "route": "/os/headless/customers",
  "metadata": {
    "title": "Headless Customers",
    "description": "The /os/customers page, composed through the UI runtime instead of hardcoded JSX."
  },
  "definition": {
    "id": "headless-customers",
    "kind": "page",
    "children": [
      {
        "id": "root-stack",
        "kind": "layout",
        "type": "stack",
        "children": [
          {
            "id": "page-header",
            "kind": "component",
            "type": "os-page-header",
            "props": {
              "title": "Customers",
              "subtitle": "Track acquisition, ordering activity, and spend across your customer base."
            },
            "children": [{ "id": "period-toggle", "kind": "component", "type": "os-period-toggle" }]
          },
          {
            "id": "kpi-grid",
            "kind": "layout",
            "type": "grid",
            "columns": { "base": 1, "md": 2, "xl": 4 },
            "children": [
              {
                "id": "kpi-total-customers",
                "kind": "component",
                "type": "os-kpi",
                "props": { "title": "Total Customers", "icon": "UsersRound" },
                "data": {
                  "value": { "source": "kpis", "path": "total_customers.value" },
                  "delta": { "source": "kpis", "path": "total_customers.delta" }
                }
              },
              {
                "id": "kpi-new-customers",
                "kind": "component",
                "type": "os-kpi",
                "props": { "title": "New Customers", "icon": "TrendingUp" },
                "data": {
                  "value": { "source": "kpis", "path": "new_customers.value" },
                  "delta": { "source": "kpis", "path": "new_customers.delta" }
                }
              },
              {
                "id": "kpi-active-customers",
                "kind": "component",
                "type": "os-kpi",
                "props": { "title": "Active Customers", "icon": "Users" },
                "data": {
                  "value": { "source": "kpis", "path": "active_customers.value" },
                  "delta": { "source": "kpis", "path": "active_customers.delta" }
                }
              },
              {
                "id": "kpi-revenue-per-customer",
                "kind": "component",
                "type": "os-kpi",
                "props": { "title": "Revenue per Customer", "icon": "DollarSign" },
                "data": {
                  "value": { "source": "kpis", "path": "revenue_per_customer.value" },
                  "delta": { "source": "kpis", "path": "revenue_per_customer.delta" }
                }
              }
            ]
          },
          {
            "id": "customer-trend",
            "kind": "component",
            "type": "os-customer-trend",
            "data": { "points": { "source": "trend", "path": "points" } }
          },
          {
            "id": "customers-table",
            "kind": "component",
            "type": "os-data-table",
            "props": {
              "searchable": true,
              "searchPlaceholder": "Search customers...",
              "filterable": true,
              "columnVisibility": true,
              "compulsoryColumns": ["name"],
              "minVisibleColumns": 3,
              "selectable": true,
              "paginated": true,
              "pageSize": 10,
              "emptyMessage": "No customers found."
            },
            "data": {
              "title": { "source": "rosterTitle" },
              "subtitle": { "source": "rosterSubtitle" },
              "data": { "source": "customers" }
            }
          }
        ]
      }
    ]
  }
}
