# Frappe/ERPNext bench site this app talks to as a backend-as-a-service.
# This is read server-side only (Route Handlers, middleware, Server Components) —
# it is never bundled into client JS and the browser never talks to it directly.
# Copy this file to .env.local and point it at your bench's site URL, e.g.
# the site you run `bench start` against.
FRAPPE_URL=http://your-site-name.localhost:8000
