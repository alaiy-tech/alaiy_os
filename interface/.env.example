# ---------------------------------------------------------------------------
# Alaiy OS Self-Serve — environment
#
# NOTHING here is NEXT_PUBLIC_. Every value is server-only on purpose: the
# browser must never talk to api.os.alaiy.com directly (cross-origin), so all
# backend calls are made from the Next.js server via src/lib/backend/client.ts.
# ---------------------------------------------------------------------------

# ERPNext / Alaiy OS backend. The single source of truth for all data.
ALAIY_BACKEND_URL=https://api.os.alaiy.com
# Service credentials the Next.js server uses to call the backend.
# ERPNext token auth: `Authorization: token <api_key>:<api_secret>`
ALAIY_BACKEND_API_KEY=
ALAIY_BACKEND_API_SECRET=
# Milliseconds before a backend call is aborted.
ALAIY_BACKEND_TIMEOUT_MS=15000

# Public origin of THIS app. Used to build OAuth redirect URIs.
APP_URL=http://localhost:3000

# Session cookie signing key. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Google SSO — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
# Leave blank for now: the connector has no google_sign_in endpoint yet, and
# the sign-in page hides the Google button while these are unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shopify OAuth is a later stage. Sellers currently paste an Admin API
# access token, which the connector verifies and stores, so no Shopify
# app credentials are needed here yet.

# Amazon SP-API credentials deliberately do NOT live here. The connector
# owns the whole OAuth flow, reading amazon_lwa_client_id / _secret and
# amazon_sp_app_id from the bench's site_config.json:
#   bench --site <site> set-config amazon_lwa_client_id "..."
